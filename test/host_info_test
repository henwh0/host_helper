"""Print the first Serf result for a hostname, i.e. host_info[0]."""

import json
import subprocess
import sys

FIELDS = "parent_asset_tag,model,rack_sub_position_slot,asset_id"


def main() -> int:
    if len(sys.argv) != 2:
        print(f"usage: {sys.argv[0]} <hostname>", file=sys.stderr)
        return 2
    hostname = sys.argv[1]

    proc = subprocess.run(
        ["serf", "get", f"name={hostname}", f"--fields={FIELDS}", "--format", "json"],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        print(f"serf failed (rc={proc.returncode}): {proc.stderr.strip()}", file=sys.stderr)
        return 1

    host_info = json.loads(proc.stdout)
    if not host_info:
        print(f"No info found for {hostname}.", file=sys.stderr)
        return 1
    if len(host_info) > 1:
        print(f"Warning: {len(host_info)} matches, showing the first.", file=sys.stderr)

    host_info = host_info[0]

    print(f"host_info for {hostname}:")
    for key, value in host_info.items():
        print(f"  {key:<24} {value!r}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
